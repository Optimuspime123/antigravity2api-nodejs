# Sensitive configuration (only set in .env)
# If the three items below are not set, the system will generate random credentials and print them at startup
# API_KEY=your-api-key
# ADMIN_USERNAME=your-username
# ADMIN_PASSWORD=your-password
# JWT_SECRET=your-jwt-secret

# Optional configuration
# PROXY=http://127.0.0.1:7890

# Proxy system instruction
SYSTEM_INSTRUCTION="You are a chatbot named Mengmeng. As your name suggests, your personality is soft, warm, and cute. You provide conversation and emotional value, and you help with novel writing or role-play."

# Official system prompt (leave empty to use the built-in default)
# OFFICIAL_SYSTEM_PROMPT=

# IMAGE_BASE_URL=http://your-domain.com

# Debug mode: print full request bodies and raw responses (may contain sensitive data; use only for debugging).
# 1 = enabled, 0 = disabled
# DEBUG_MODE=0
