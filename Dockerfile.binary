# Run with the compiled binary
# This image is smaller, starts faster, and uses less memory
#
# Build steps:
# 1. Run npm run build:linux or npm run build:linux-arm64 to generate dist
# 2. Run docker build -f Dockerfile.binary -t antigravity .

FROM debian:bookworm-slim

WORKDIR /app

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy compiled artifacts (built by CI workflow)
# Use wildcard to match binaries for different architectures
COPY dist/antigravity-linux-* /app/antigravity
COPY dist/public /app/public
COPY dist/bin /app/bin
COPY dist/src/utils/proto /app/src/utils/proto
COPY dist/config.json /app/config.json

# Set executable permissions
RUN chmod +x /app/antigravity && \
    (chmod +x /app/bin/* 2>/dev/null || true)

# Create data and image directories, plus a default .env
RUN mkdir -p /app/data /app/public/images && \
    echo "# Sensitive configuration (only set in .env)" > /app/.env && \
    echo "# If the three items below are not set, random credentials will be generated at startup" >> /app/.env && \
    echo "# API_KEY=your-api-key" >> /app/.env && \
    echo "# ADMIN_USERNAME=your-username" >> /app/.env && \
    echo "# ADMIN_PASSWORD=your-password" >> /app/.env && \
    echo "# JWT_SECRET=your-jwt-secret" >> /app/.env && \
    echo "" >> /app/.env && \
    echo "# Optional configuration" >> /app/.env && \
    echo "# PROXY=http://127.0.0.1:7890" >> /app/.env && \
    echo "" >> /app/.env && \
    echo "# Proxy system instruction" >> /app/.env && \
    echo "SYSTEM_INSTRUCTION=You are a coding and  general purprose AI assistant." >> /app/.env && \
    echo "" >> /app/.env && \
    echo "# Official system prompt (leave empty to use the built-in default)" >> /app/.env && \
    echo "# OFFICIAL_SYSTEM_PROMPT=" >> /app/.env && \
    echo "" >> /app/.env && \
    echo "# IMAGE_BASE_URL=http://your-domain.com" >> /app/.env

# Create entrypoint to sync env vars into .env
RUN cat > /app/entrypoint.sh << 'EOF'
#!/bin/sh
# Sync environment variables into .env
ENV_FILE="/app/.env"

# Sync a single env var
# Use ${var+x} to detect whether the variable is set (including empty values)
sync_env() {
  key=$1
  # Check if the variable is set (including empty values)
  if eval "[ \"\${${key}+x}\" ]"; then
    value=$(eval echo "\$$key")
    # Check if the config already exists
    if grep -q "^${key}=" "$ENV_FILE" 2>/dev/null; then
      # Replace existing config (use # as a delimiter to avoid special chars)
      sed -i "s#^${key}=.*#${key}=${value}#" "$ENV_FILE"
    else
      # Add new config
      echo "${key}=${value}" >> "$ENV_FILE"
    fi
    if [ -n "$value" ]; then
      echo "✓ Synced env var: ${key}=${value}"
    else
      echo "✓ Synced env var: ${key}=(empty)"
    fi
  fi
}

# Sync all supported variables
sync_env "API_KEY"
sync_env "ADMIN_USERNAME"
sync_env "ADMIN_PASSWORD"
sync_env "JWT_SECRET"
sync_env "PROXY"
sync_env "SYSTEM_INSTRUCTION"
sync_env "OFFICIAL_SYSTEM_PROMPT"
sync_env "IMAGE_BASE_URL"

# Start the app
exec /app/antigravity
EOF
RUN chmod +x /app/entrypoint.sh

# Expose port
EXPOSE 8045

# Start the app
CMD ["/app/entrypoint.sh"]
